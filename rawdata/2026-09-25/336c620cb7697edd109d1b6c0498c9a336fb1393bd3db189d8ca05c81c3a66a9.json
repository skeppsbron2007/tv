n total 37,827,020 Sampo A shares representing 1.42 per cent of the total number of shares in Sampo plc."]},{"type":"p","children":["Details of each transaction are included as an appendix of this announcement."]},{"type":"p","children":["On behalf of Sampo plc,"]},{"type":"p","children":["Morgan Stanley Co. International plc"]},{"type":"p","children":[{"type":"b","children":["For further information, please contact:"]}]},{"type":"p","children":[{"type":"b","children":["Mirko Hurmerinta"]}]},{"type":"p","children":["Interim Head of Investor Relations"]},{"type":"p","children":["tel. +358 10 516 0032"]},{"type":"p","children":[{"type":"b","children":["Distribution:"]}]},{"type":"p","children":["Nasdaq Helsinki"]},{"type":"p","children":["Nasdaq Stockholm"]},{"type":"p","children":["Nasdaq Copenhagen"]},{"type":"p","children":["London Stock Exchange"]},{"type":"p","children":["FIN-FSA"]},{"type":"p","children":["The principal media"]},{"type":"p","children":["www.sampo.com"]},{"type":"p","children":[{"type":"b","children":["Attachment"]}]},{"type":"list","children":[{"type":"*","children":[{"type":"url","params":{"url":"https://ml-eu.globenewswire.com/Resource/Download/e6b3f74e-d5eb-4609-8851-06808fe330ba","linkText":"Sampo_share_buyback_week_39_2026"}}]}]}]},"language":"en","tags":[{"title":"Finnish stocks","args":[{"id":"category","value":"stock"},{"id":"market_country","value":"FI"}]},{"title":"GlobeNewswire","args":[{"id":"provider","value":"globenewswire"}]},{"title":"Share buybacks","args":[{"id":"section","value":"share_buybacks"}]}],"robots":["noindex"],"id":"globenewswire:c3577c543094b:0","title":"Sampo plc’s share buybacks week 39/2026","published":1790314200,"urgency":2,"link":"https://www.globenewswire.com/news-release/2026/09/25/3368841/0/en/sampo-plc-s-share-buybacks-week-39-2026.html","relatedSymbols":[{"symbol":"OMXHEX:SAMPO","logoid":"sampo-plc-a","logo":{"style":"single","logoid":"sampo-plc-a"}}],"storyPath":"/news/globenewswire:c3577c543094b:0-sampo