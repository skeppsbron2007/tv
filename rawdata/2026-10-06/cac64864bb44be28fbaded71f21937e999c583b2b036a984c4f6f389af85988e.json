ype":"table-row","children":[{"type":"table-data-cell","children":["Saúl Villarreal, Chief Financial Officer"]},{"type":"table-data-cell","children":["svillarreal@aeropuertosgap.com.mx"]}]},{"type":"table-row","children":[{"type":"table-data-cell","children":["Gisela Murillo, Investor Relations"]},{"type":"table-data-cell","children":["gmurillo@aeropuertosgap.com.mx+52 33 3880 1100 ext. 20294"]}]}]}]}]},"language":"en","tags":[{"title":"GlobeNewswire","args":[{"id":"provider","value":"globenewswire"}]},{"title":"Mexican stocks","args":[{"id":"category","value":"stock"},{"id":"market_country","value":"MX"}]},{"title":"Strategy, business, and products","args":[{"id":"section","value":"strategy_business_products"}]}],"robots":["noindex"],"id":"globenewswire:38ab609c9094b:0","title":"Grupo Aeroportuario del Pacifico Reports a Passenger Traffic Decrease in September 2026 of 7.3% Compared to 2025","published":1791329400,"urgency":2,"link":"https://www.globenewswire.com/news-release/2026/10/06/3376140/0/en/grupo-aeroportuario-del-pacifico-reports-a-passenger-traffic-decrease-in-september-2026-of-7-3-compared-to-2025.html","relatedSymbols":[{"symbol":"BMV:GAP/B","logoid":"gpo-aeroportuario-del-pacifico","logo":{"style":"single","logoid":"gpo-aeroportuario-del-pacifico"}}],"storyPath":"/news/globenewswire:38ab609c9094b:0-grupo-aeroportuario-del-pacifico-reports-a-passenger-traffic-decrease-in-september-2026-of-7-3-compared-to-2025/","read_time":262,"provider":{"id":"globenewswire","name":"GlobeNewswire","logo_id":"rdp-gnw","url":"https://www.globenewswire.com/"}}